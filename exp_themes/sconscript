import os
from os.path import join as path_join

from dotenv import load_dotenv
from nestly import Nest
from nestly.scons import SConsWrap
from SCons.Script import Import

load_dotenv()

# For SCons - Import env from parent
Import("env")
localenv = env.Clone()

# Available prompt versions for question type extraction
PROMPT_VERSIONS_DICT = {
     "v1": {
         "limit": 200,  # Start small for testing
         "seed": 42,
         "max_char": 10000,
         "llm_model": "bedrock/us.anthropic.claude-sonnet-4-20250514-v1:0",
     },
}
PROMPT_VERSIONS = list(PROMPT_VERSIONS_DICT.keys())

# Tagging configuration - uses cleaned categories to tag all questions
TAGGING_DICT = {
    "v1": {
        "limit": None,  # Process all questions
        "seed": None,
        "max_char": 10000,
        "llm_model": "bedrock/us.anthropic.claude-sonnet-4-20250514-v1:0",
        "response_model": "QuestionTagging",
    },
}

# Cache configuration for LLM calls
CACHE_FILE = "cache.db"

# Set up nestly state
nest = SConsWrap(Nest(), localenv["output"], alias_environment=localenv)

# LLM Configuration
LLM_DICT = {
    "batch_size": 10,
    "max_retries": 1,
    "temperature": {
        "bedrock/us.anthropic.claude-sonnet-4-20250514-v1:0": 1,
    }
}

# Clustering parameters
CLUSTERING_CONFIGS = {
    "default": {
        "n_clusters": 15,  # More clusters for question types
        "embedding_model": "all-MiniLM-L6-v2",
    },
}

# Source data paths
DATA_DIR = "data_6-21-3-56-00pm-nohb"
QUESTIONS_CSV = f"{DATA_DIR}/qa_questions.csv"
ASSIGNMENTS_CSV = f"{DATA_DIR}/qa_assignments.csv"
RATINGS_CSV = f"{DATA_DIR}/blinded_ratings.csv"

# First, filter to rated questions
@nest.add_target_with_env(localenv)
def filter_rated_questions(env, outdir, c):
    """Filter questions to only those with at least one rating"""
    cmd = [
        "python src/filter_rated_questions.py",
        f"--questions-csv {QUESTIONS_CSV}",
        f"--assignments-csv {ASSIGNMENTS_CSV}",
        f"--ratings-csv {RATINGS_CSV}",
        "--output-csv ${TARGETS[0]}",
    ]

    sources = []
    targets = [path_join(outdir, "rated_questions.csv")]

    return env.Command(targets, sources, " ".join(map(str, cmd)))

nest.add("prompt_version", PROMPT_VERSIONS_DICT, label_func=lambda c: "prompt_%s" % c)

@nest.add_target_with_env(localenv)
def extract_question_types(env, outdir, c):
    """Extract question type keyphrases from clinical questions"""
    prompt_template_path = f"exp_themes/prompts/{c['prompt_version']}_extraction_template.txt"
    llm_model = PROMPT_VERSIONS_DICT[c["prompt_version"]]["llm_model"]

    cmd = [
        "python src/extract_themes.py",
        "--input-csv ${SOURCES[0]}",
        "--output-csv ${TARGETS[0]}",
        "--prompt-template", prompt_template_path,
        "--cache-db", CACHE_FILE,
        "--log-file ${TARGETS[1]}",
        "--limit 1",
        "--model", llm_model,
        "--batch-size", LLM_DICT["batch_size"],
        "--max-retries", LLM_DICT["max_retries"],
        "--temperature", LLM_DICT["temperature"][llm_model],
        "--limit", PROMPT_VERSIONS_DICT[c["prompt_version"]]["limit"],
        "--random-seed", PROMPT_VERSIONS_DICT[c["prompt_version"]]["seed"],
        "--max-char", PROMPT_VERSIONS_DICT[c["prompt_version"]]["max_char"],
        "--response-model", "QuestionTypeExtraction",
        "--id-column", "id",
    ]

    sources = c["filter_rated_questions"][0]  # rated_questions.csv
    targets = [
        path_join(outdir, "extracted_types.csv"),
        path_join(outdir, "log_extraction.txt"),
    ]

    return env.Command(targets, sources, " ".join(map(str, cmd)))

